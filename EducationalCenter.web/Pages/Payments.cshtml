@page
@model EducationalCenter.web.Pages.PaymentsModel
@{
    ViewData["Title"] = "Payments";
}

<h2>Payments</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<form method="get">
    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label">View payment history for</label>
            <select name="StudentId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select a student --</option>
                @foreach (var s in Model.Students)
                {
                    <option value="@s.Id" selected="@(Model.StudentId == s.Id)">@s.FirstName @s.LastName</option>
                }
            </select>
        </div>
    </div>
</form>

@if (Model.StudentId.HasValue)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Course</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Payments)
        {
            <tr>
                <td>@p.Date.ToShortDateString()</td>
                <td>@p.CourseName</td>
                <td>@p.Amount.ToString("C")</td>
                <td>@p.PaymentMethod</td>
                <td>@p.Status</td>
            </tr>
        }
        </tbody>
    </table>
}

<h4>Record a Payment</h4>
<form method="post">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Enrollment</label>
            <select asp-for="NewEnrollmentId" class="form-select">
                @foreach (var e in Model.EnrollmentOptions)
                {
                    <option value="@e.Id">@e.Label</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Amount</label>
            <input asp-for="NewAmount" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Method</label>
            <select asp-for="NewPaymentMethod" class="form-select">
                <option>Cash</option>
                <option>CreditCard</option>
                <option>InstaPay</option>
                <option>Wallet</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Record</button>
        </div>
    </div>
</form>
